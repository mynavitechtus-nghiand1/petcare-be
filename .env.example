# Application
APP_NAME="PetCare Learning"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:8080

# Database (Docker service name = database)
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

AUTH_GUARD=sanctum
AUTH_ACCESS_TOKEN_TTL=60
AUTH_REFRESH_TOKEN_TTL=7

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (MailHog)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Docker
COMPOSE_PROJECT_NAME=petcare-learning
DOCKER_NGINX_PORT=8080
DOCKER_DATABASE_PORT=5432
DOCKER_REDIS_PORT=6379
DOCKER_MAILHOG_SMTP_SERVER_PORT=1025
DOCKER_MAILHOG_WEB_UI_PORT=8025

# Runtime drivers
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_DRIVER=log

LOG_CHANNEL=stack
LOG_LEVEL=debug
