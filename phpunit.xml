<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Integration</exclude>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Feature/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
        <exclude>
            <!-- Exclude vendor, tests, migrations, etc. -->
            <directory>vendor</directory>
            <directory>tests</directory>
            <directory>database</directory>
            <directory>bootstrap</directory>
            <directory>storage</directory>
            <directory>routes</directory>
            <directory>resources</directory>
            <directory>config</directory>
            <directory>public</directory>
            <directory>infrastructure</directory>
            <!-- Exclude module-specific directories that don't need coverage -->
            <!-- These patterns exclude files in module subdirectories -->
            <file>Modules/*/database/**/*.php</file>
            <file>Modules/*/tests/**/*.php</file>
            <file>Modules/*/routes/**/*.php</file>
            <file>Modules/*/resources/**/*.php</file>
            <file>Modules/*/config/**/*.php</file>
            <file>Modules/*/Providers/**/*.php</file>
            <file>Modules/*/database/*.php</file>
            <file>Modules/*/tests/*.php</file>
            <file>Modules/*/routes/*.php</file>
            <file>Modules/*/resources/*.php</file>
            <file>Modules/*/config/*.php</file>
            <file>Modules/*/Providers/*.php</file>
        </exclude>
    </source>
    <php>
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="testing"/>
        <server name="DB_TEST_HOST" value="database"/>
        <server name="DB_TEST_PORT" value="5432"/>
        <server name="DB_TEST_DATABASE" value="laravel_test"/>
        <server name="DB_TEST_USERNAME" value="laravel"/>
        <server name="DB_TEST_PASSWORD" value="secret"/>
        <env name="REDIS_HOST" value="redis"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="null"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Disable route caching in test environment to prevent memory issues -->
        <env name="ROUTE_CACHE" value="false"/>
    </php>
</phpunit>
